rules_version = '2';

// Images des tunnels custom : lecture publique (les tunnels publics
// sont lisibles par tous), écriture owner-only (< 5 Mo, images only).
// Chemin imposé : tunnel-images/{uid}/{fichier} — l'uid du chemin doit
// correspondre à l'utilisateur authentifié.
service firebase.storage {
  match /b/{bucket}/o {
    match /tunnel-images/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
