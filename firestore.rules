rules_version = '2';

// Règles prod QuizRail.
// - users/{uid} : owner-only (lecture + écriture).
// - tunnels : lecture publique, écriture réservée au créateur
//   (creatorId doit valoir request.auth.uid à la création).
// - sessions : uniquement les participants (participantIds contient l'uid).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /tunnels/{tunnelId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.creatorId == request.auth.uid
        // L'agrégat de notes est calculé par rateTunnel uniquement :
        // interdit dès la création (pas de faux 5,0 à la publication).
        && !('ratingSum' in request.resource.data)
        && !('ratingCount' in request.resource.data)
        && !('ratingAvg' in request.resource.data);
      // Le créateur peut tout modifier SAUF l'agrégat de notes
      // (ratingSum/Count/Avg : callable rateTunnel uniquement).
      allow update: if signedIn()
        && resource.data.creatorId == request.auth.uid
        && !('ratingSum' in request.resource.data.diff(resource.data).affectedKeys())
        && !('ratingCount' in request.resource.data.diff(resource.data).affectedKeys())
        && !('ratingAvg' in request.resource.data.diff(resource.data).affectedKeys());
      allow delete: if signedIn()
        && resource.data.creatorId == request.auth.uid;
    }

    // Notes individuelles : écriture fonction uniquement, jamais lisibles
    // (l'agrégat public vit sur le doc tunnel).
    match /tunnels/{tunnelId}/ratings/{uid} {
      allow read, write: if false;
    }

    // Signalements : écriture fonction uniquement, file admin consultée
    // manuellement dans la console (status == 'pending').
    match /reports/{reportId} {
      allow read, write: if false;
    }

    // Classements : lecture connectée, écriture fonctions uniquement.
    match /leaderboard/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Rooms Party : lecture participants uniquement, AUCUNE écriture
    // client sur la room (tout passe par les callables host/joueurs).
    match /rooms/{roomId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.playerIds;
      allow create, update, delete: if false;

      // Présence : chaque joueur ne touche que lastSeen/connected
      // de SON propre doc (heartbeat 10 s, ~1 écriture/s pour 10 joueurs).
      match /players/{uid} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.playerIds;
        allow update: if isOwner(uid)
          && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.playerIds
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['lastSeen', 'connected']);
        allow create, delete: if false;
      }

      // Réponses de la room : jamais lisibles côté client.
      match /secret/{docId} {
        allow read, write: if false;
      }
    }

    match /sessions/{sessionId} {
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participantIds;
      allow read, update, delete: if signedIn()
        && request.auth.uid in resource.data.participantIds;
    }

    // File de matchmaking duel : chacun ne gère que sa propre entrée.
    // L'appariement est fait par la Cloud Function findDuel (Admin SDK).
    match /duelQueue/{uid} {
      allow read, create, delete: if isOwner(uid);
      allow update: if false;
    }

    // Duels temps réel : lecture participants uniquement, AUCUNE écriture
    // client sur le score/les questions (arbitrage 100 % Cloud Functions).
    // Seule la présence (lastSeen/connected de SON propre joueur) est
    // modifiable directement par le client.
    match /duels/{duelId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.playerIds;
      allow create, delete: if false;
      allow update: if signedIn()
        && request.auth.uid in resource.data.playerIds
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['players'])
        && request.resource.data.players.diff(resource.data.players)
            .affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.players[request.auth.uid]
            .diff(resource.data.players[request.auth.uid])
            .affectedKeys().hasOnly(['lastSeen', 'connected']);
    }

    // Réponses du duel : jamais lisibles ni modifiables côté client.
    // Seules les Cloud Functions (Admin SDK) y accèdent.
    match /duels/{duelId}/secret/{docId} {
      allow read, write: if false;
    }
  }
}
